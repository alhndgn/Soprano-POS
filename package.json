{
  "name": "soprano-pos",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Soprano POS - restoran satis noktasi. Developed by TeqStudio.",
  "scripts": {
    "dev": "concurrently -n api,ui -c cyan,magenta \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "bridge": "tsx src/bridge/index.ts",
    "seed": "tsx src/server/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "author": "TeqStudio",
  "license": "MIT"
}
