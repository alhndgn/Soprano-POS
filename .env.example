# Soprano POS — ortam değişkenleri örneği
# Kopyala: cp .env.example .env  (npm run start bunu otomatik okumaz; kabuğunda export et)

PORT=8095
SOPRANO_DB=./var/pgdata

# Yazıcı köprüsü (npm run bridge)
SOPRANO_API=http://127.0.0.1:8095
# RECEIPT_PRINTER=192.168.1.50:9100
# KITCHEN_PRINTER=192.168.1.51:9100
# DRY_RUN=1
# SOPRANO_PRINTER_CP857=1

LOG_LEVEL=info
